	<text rend="100" xml:lang="la">
		<body corresp="#D #W #O #L #H #C #F #P1 #X">
			<div type="section1">
				<head>
					<app>
						<lem wit="#D #W #O #L #C #F #P1 #X">
							<app>
								<lem wit="#D #W #L #P1"/>
								<rdg wit="#O #C" cause="addition" n="signifiante">Ad honorem
									Dei</rdg>
								<rdg wit="#F" n="signifiante" cause="addition">In nomine domini
									nostri YHU XPI amen</rdg>
								<rdg wit="#X" cause="addition" n="signifiante">De Indorum, Persarum
									Egiptorumque disciplina</rdg>
							</app> Ad <app>
								<lem wit="#D #W #O #L #C #X">Hugonem</lem>
								<rdg wit="#F #P1" n="signifiante">Ugonem</rdg>
							</app>
							<app>
								<lem wit="#W #F #P1">Eterianum</lem>
								<rdg wit="#D #X" n="signifiante">Eterialium</rdg>
								<rdg wit="#O #C" cause="omission" n="signifiante"/>
								<rdg wit="#L" n="signifiante">imperalium</rdg>
							</app> doctorem suum <app>
								<lem wit="#D #W #L #F #P1 #X">et utraque origine fratrem</lem>
								<rdg wit="#O #C" cause="omission" n="signifiante"/>
							</app> Leo <app>
								<lem wit="#D #W #O #L #C #F #X">Tuscus</lem>
								<rdg wit="#P1">Tuschus</rdg>
							</app>
							<app>
								<lem wit="#D #W #L #F #P1 #X">imperatoriarum epistolarum interpres
									de <app>
										<lem wit="#D #W #L #F #P1">sompniis</lem>
										<rdg wit="#X">somniis</rdg>
									</app> et oraculis</lem>
								<rdg wit="#O #C" n="signifiante">interpres imperatoriarum
									epistolarum prologus incipit de interpretatione somniorum</rdg>
							</app>
						</lem>
						<rdg wit="#H" n="signifiante">Incipit liber sompniorum latine doctus loqui a
							Leone imperialium epistolarum interprete temporibus Magni Imperatoris
							Manuel</rdg>
					</app>
				</head>
				<p><app>
						<lem wit="#D #W #L #H #F #P1 #X">Quamquam</lem>
						<rdg wit="#O #C" n="signifiante">Quam</rdg>
					</app>, optime <app>
						<lem wit="#D #W #O #L #H #C #F #P1 #X">preceptor</lem>
						<rdg wit="#C" n="signifiante"><add hand="#m2" place="interligne"
								>preceptor</add></rdg>
					</app>, invictum imperatorem Manuel per fines sequar <app>
						<lem wit="#D #W #F #X">Bitinie</lem>
						<rdg wit="#O">Bithimie</rdg>
						<rdg wit="#L #H #P1">Bithinie</rdg>
						<rdg wit="#C">Bithiniae</rdg>
					</app>
					<app>
						<lem wit="#D #W #O #L #H #F #X">Licaonieque</lem>
						<rdg wit="#C">Licaoniaeque</rdg>
						<rdg wit="#P1">Liconieque</rdg>
					</app> fugantem <app>
						<lem wit="#D #W #O #L #H #C #P1 #X">Persas</lem>
						<rdg wit="#F" n="signifiante">Speras</rdg>
					</app> flexipedum hederarum <app>
						<lem wit="#D #W #O #H #C #F #P1">complectentes</lem>
						<rdg wit="#L" n="signifiante">complectantes</rdg>
						<rdg wit="#X" n="signifiante">complectens</rdg>
					</app>, vestigia tamen memorandi non <app>
						<lem wit="#D #W #O #L #H #C #F #P1 #X">sum</lem>
						<rdg wit="#C" n="signifiante"><mod hand="#m2"><del rend="biffe"
									>solum</del><add place="surcharge">sum</add></mod></rdg>
					</app> oblitus <app>
						<lem wit="#D #W #L #H #F #P1 #X">sompnii</lem>
						<rdg wit="#O #C">somnii</rdg>
					</app> a te <app>
						<lem wit="#D #W #O #L #C #F #P1 #X">visi</lem>
						<rdg wit="#H" n="signifiante">nisi</rdg>
					</app> qui dictum inexpugnabilem virum <app>
						<lem wit="#D #W #O #L #H #F #P1 #X"><app>
								<lem wit="#D #W #O #L #H #P1 #X">eneo</lem>
								<rdg wit="#F">heneo</rdg>
								<rdg wit="#P1"><del rend="biffe">in eo</del></rdg>
							</app> in equo</lem>
						<rdg wit="#C" n="signifiante">equo eneos</rdg>
					</app>
					<app>
						<lem wit="#W #O #L #H #C #F #P1 #X">supra</lem>
						<rdg wit="#D" n="signifiante">supera</rdg>
					</app>
					<app>
						<lem wit="#D #W #O #L #H #C #P1 #X">columpnam</lem>
						<rdg wit="#F" n="signifiante">collumpna</rdg>
					</app>
					<app>
						<lem wit="#D #W #O #L #H #C #F #X">quam</lem>
						<rdg wit="#P1">qua</rdg>
					</app> Traces dicunt <app>
						<lem wit="#D #L">augustiana</lem>
						<rdg wit="#W" n="signifiante">augustiona</rdg>
						<rdg wit="#O #C" n="signifiante">augustonia</rdg>
						<rdg wit="#H #P1" n="signifiante">angustiona</rdg>
						<rdg wit="#F" n="signifiante">augustionam</rdg>
						<rdg wit="#X" n="signifiante">augustiniana</rdg>
					</app>
					<app>
						<lem wit="#W #O #H #C #F #P1">Bisantii</lem>
						<rdg wit="#D #X" n="signifiante">Bizantii</rdg>
						<rdg wit="#L" n="signifiante">Bizanzii</rdg>
					</app>
					<app>
						<lem wit="#D #W #O #L #H #C #P1 #X">sito</lem>
						<rdg wit="#F" n="signifiante">situm</rdg>
					</app> nobiliter <app>
						<lem wit="#D #W #O #L #H #F #P1 #X">sedere</lem>
						<rdg wit="#C" n="signifiante">sedem</rdg>
					</app>
					<app>
						<lem wit="#D #O #C #X">conspicabaris</lem>
						<rdg wit="#W" n="signifiante">conspicabisaris</rdg>
						<rdg wit="#L" n="signifiante">conconspicabaris</rdg>
						<rdg wit="#H #P1" n="signifiante">conspica</rdg>
						<rdg wit="#F" n="signifiante"><mod hand="#m1"><del rend="exponctuation"
									>conpiscabaris</del><add place="inline"
								>conpiscabaris</add></mod></rdg>
					</app>. <app>
						<lem wit="#D #W #O #L #C #F #X"><app>
								<lem wit="#D #W #O #L #F #X">Eodem</lem>
